Options -Indexes
RewriteEngine On

RewriteRule ^(?:config|src|storage)(?:/|$) - [F,L]
RewriteRule ^robots\.txt$ public/robots.php [L,QSA]
RewriteRule ^sitemap\.xml$ public/sitemap.php [L,QSA]
RewriteRule ^feed/([a-zA-Z0-9]+)/category/([^/]+)/([a-z0-9-]+)/?$ feed/random.php?site=$1&category=$2&slug=$3 [L,QSA]
RewriteRule ^feed/([a-zA-Z0-9]+)/([a-z0-9-]+)/?$ feed/random.php?site=$1&slug=$2 [L,QSA]

# 実在しないURLはサーバー標準404を見せず、阿修羅のログイン画面へ戻す。
# 既存ファイル・既存ディレクトリ・上記の仮想URLは対象外。
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ login.php [R=302,L]

<FilesMatch "^(?:\.env|composer\.(?:json|lock)|phpunit\.xml)$">
    Require all denied
</FilesMatch>
